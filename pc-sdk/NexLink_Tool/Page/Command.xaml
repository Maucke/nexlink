<Page x:Class="NexLink_Tool.Page.Command"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NexLink_Tool"
      mc:Ignorable="d" 
      xmlns:dd="urn:gong-wpf-dragdrop" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:viewmodel="clr-namespace:NexLink_Tool.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:CommandViewModel}"
      d:DesignHeight="450" d:DesignWidth="1000" FontFamily="Segoe UI" x:Name="pg_cmd">
    <Page.Resources>
        <local:HexConverter x:Key="HexConverter" />
    </Page.Resources>

    <Grid Margin="5">
        <StackPanel>
            <Expander IsExpanded="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ReceiptSparkles24" Filled="True"></ui:SymbolIcon>
                        <TextBlock VerticalAlignment="Center" Grid.Column="1" Text="Functions" Width="150" HorizontalAlignment="Left" Margin="5" FontWeight="DemiBold"></TextBlock>
                    </Grid>
                </Expander.Header>
                <WrapPanel>
                    <ui:Button Margin="5" Width="120" Content="SYNC Time" CommandParameter="SYNC Time" Command="{Binding Execute}" Appearance="Primary" Foreground="White"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="GetDisplayInfo" CommandParameter="GetDisplayInfo" Command="{Binding Execute}" Appearance="Success" Foreground="White"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Show Picture" CommandParameter="Show Picture" Command="{Binding Execute}" Appearance="Light"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Reset" CommandParameter="Reset" Command="{Binding Execute}" Appearance="Danger"></ui:Button>
                </WrapPanel>
            </Expander>
            <Expander IsExpanded="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Archive24" Filled="True"></ui:SymbolIcon>
                        <TextBlock VerticalAlignment="Center" Grid.Column="1" Text="Custom Commands" HorizontalAlignment="Left" Margin="5" FontWeight="DemiBold"></TextBlock>
                    </Grid>
                </Expander.Header>
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding CustomNexCommands}" Background="Transparent"
          dd:DragDrop.IsDragSource="True"
          dd:DragDrop.IsDropTarget="True"
          dd:DragDrop.UseDefaultDragAdorner="True"
          dd:DragDrop.UseDefaultEffectDataTemplate="True"
          dd:DragDrop.DropHandler="{Binding DropHandler}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Margin="5" Width="120" Content="{Binding Name}" CommandParameter="{Binding}" Command="{Binding DataContext.Request, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Appearance="Secondary">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
    Command="{Binding DataContext.Delete, Source={x:Reference pg_cmd}}"
                  CommandParameter="{Binding}" >
                                                <MenuItem.Header>
                                                    <DockPanel>
                                                        <ui:SymbolIcon Symbol="Delete20" Margin="2"></ui:SymbolIcon>
                                                        <TextBlock Margin="5,0" Grid.Column="1" Text="Delete" VerticalAlignment="Center"></TextBlock>
                                                    </DockPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel></WrapPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </WrapPanel>
            </Expander>
            <Expander IsExpanded="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArchiveMultiple24" Filled="True"></ui:SymbolIcon>
                        <TextBlock VerticalAlignment="Center" Grid.Column="1" Text="Advance Commands" HorizontalAlignment="Left" Margin="5" FontWeight="DemiBold"></TextBlock>
                        <ui:Button Grid.Column="2" ToolTip="Add Command" Padding="5,2" Margin="5" Icon="{ui:SymbolIcon Add24}" Command="{Binding Add}" Appearance="Info" Foreground="White"/>
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding NexCommands}" MinHeight="50" Background="Transparent"
          dd:DragDrop.IsDragSource="True"
          dd:DragDrop.IsDropTarget="True"
          dd:DragDrop.UseDefaultDragAdorner="True"
          dd:DragDrop.UseDefaultEffectDataTemplate="True"
          dd:DragDrop.DropHandler="{Binding DropHandler}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBox Padding="4,2" MinWidth="120" TextWrapping="Wrap" Text="{Binding Name}" HorizontalAlignment="Stretch" Margin="5" DockPanel.Dock="Left" ToolTip="{Binding Name}"></TextBox>
                                <ComboBox Padding="4,2" MinWidth="160"
                                  ItemsSource="{Binding DataContext.NexLinkCmdValues, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}"
                                  SelectedItem="{Binding Cmd}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="5"></ComboBox>
                                <ui:Button Padding="4,2" Appearance="Secondary" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Delete24}" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="5" Command="{Binding DataContext.Delete, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding}"></ui:Button>
                                <ui:Button Padding="4,2" Foreground="White" Appearance="Primary" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Send24}" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="5" Command="{Binding DataContext.Request, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding}"></ui:Button>
                                <TextBox Padding="4,2" TextWrapping="Wrap" Text="{Binding Data}" HorizontalAlignment="Stretch" Margin="5" DockPanel.Dock="Left" ToolTip="{Binding AsciiData}"></TextBox>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Grid>
</Page>
