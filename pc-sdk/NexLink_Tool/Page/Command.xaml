<Page x:Class="NexLink_Tool.Page.Command"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NexLink_Tool"
      mc:Ignorable="d" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:viewmodel="clr-namespace:NexLink_Tool.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:CommandViewModel}"
      d:DesignHeight="450" d:DesignWidth="1000" FontFamily="Segoe UI">
    <Page.Resources>
        <local:HexConverter x:Key="HexConverter" />
    </Page.Resources>

    <Grid Margin="5">
        <StackPanel>
            <Expander IsExpanded="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Archive24" Filled="True"></ui:SymbolIcon>
                        <TextBlock Grid.Column="1" Text="NexLink Commands" Width="150" HorizontalAlignment="Left" Margin="5" FontWeight="DemiBold"></TextBlock>
                    </Grid>
                </Expander.Header>
                <WrapPanel>
                    <ui:Button Margin="5" Width="120" Content="SYNC Time" CommandParameter="SYNC Time" Command="{Binding Execute}" Appearance="Info"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Reset" CommandParameter="Reset" Command="{Binding Execute}" Appearance="Primary"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="GetDisplayInfo" CommandParameter="GetDisplayInfo" Command="{Binding Execute}" Appearance="Primary"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Show Picture" CommandParameter="Show Picture" Command="{Binding Execute}" Appearance="Primary"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Test" CommandParameter="Test" Command="{Binding Execute}" Appearance="Caution" Foreground="White"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Up" CommandParameter="Up" Command="{Binding Execute}" Appearance="Light"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Down" CommandParameter="Down" Command="{Binding Execute}" Appearance="Light"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Enter" CommandParameter="Enter" Command="{Binding Execute}" Appearance="Light"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Exit" CommandParameter="Exit" Command="{Binding Execute}" Appearance="Light"></ui:Button>
                </WrapPanel>
            </Expander>
            <Expander IsExpanded="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArchiveMultiple24" Filled="True"></ui:SymbolIcon>
                        <TextBlock Grid.Column="1" Text="NexLink Advance Commands" HorizontalAlignment="Left" Margin="5" FontWeight="DemiBold"></TextBlock>
                        <ui:Button Grid.Column="2" ToolTip="Add Command" Padding="5,2" Margin="5" Icon="{ui:SymbolIcon Add24}" Command="{Binding Add}" Appearance="Info" Foreground="White"/>
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding NexCommands}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <ComboBox
                                  ItemsSource="{Binding DataContext.NexLinkCmdValues, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}"
                                  SelectedItem="{Binding Cmd}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="5"></ComboBox>
                                <ui:Button Appearance="Secondary" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Delete24}" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="5" Command="{Binding DataContext.Delete, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding}"></ui:Button>
                                <ui:Button Appearance="Primary" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon Send24}" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="5" Command="{Binding DataContext.Request, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding}"></ui:Button>
                                <TextBox TextWrapping="Wrap" Text="{Binding Data}" HorizontalAlignment="Stretch" Margin="5" DockPanel.Dock="Left" ToolTip="{Binding AsciiData}"></TextBox>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Grid>
</Page>
