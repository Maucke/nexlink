<Page x:Class="NexLink_Tool.Page.Setting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NexLink_Tool.Page"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" FontFamily="Segoe UI"
      Title="Setting">

    <Grid>
        <StackPanel>
            <Expander IsExpanded="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Apps24" Filled="True"></ui:SymbolIcon>
                        <TextBlock Grid.Column="1" Text="NexLink Devices" Width="150" HorizontalAlignment="Left" Margin="5" FontWeight="DemiBold"></TextBlock>
                        <ui:Button Grid.Column="2" ToolTip="Scan devices" Padding="5,2" Margin="5" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding Scan}" Appearance="Success" Foreground="White"/>
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding NexDevices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Product}" VerticalAlignment="Center" Margin="5" FontWeight="Bold"></TextBlock>
                                <TextBlock Text="{Binding Description}" FontSize="12" VerticalAlignment="Center" Margin="5" FontStyle="Italic"></TextBlock>
                                <ui:ToggleSwitch IsChecked="{Binding IsConnect}" OnContent="Connect" Width="130" OffContent="Disconnect" HorizontalAlignment="Right" Margin="5" Command="{Binding DataContext.Control, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding}"></ui:ToggleSwitch>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Grid>
</Page>
