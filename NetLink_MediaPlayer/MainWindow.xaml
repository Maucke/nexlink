<Window x:Class="NetLink_MediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mediaControl="clr-namespace:AxWMPLib;assembly=AxInterop.WMPLib"
        xmlns:local="clr-namespace:NetLink_MediaPlayer"
        mc:Ignorable="d"
        Title="MainWindow" Height="256" Width="320" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" ResizeMode ="NoResize" Closing="Window_Closing">
    <Grid>
        <WindowsFormsHost Name="windowsFormsHost" Margin="0,0,0,30">
            <mediaControl:AxWindowsMediaPlayer x:Name="frm_media"/>
        </WindowsFormsHost>
        <Button x:Name="btn_start" Content="Start" HorizontalAlignment="Left" Margin="10,0,0,6" Width="44" Click="btn_start_Click" Height="19" VerticalAlignment="Bottom"/>
        <Button x:Name="btn_time" Content="Time" HorizontalAlignment="Left" Margin="59,0,0,6" Width="44" Click="btn_time_Click" Height="19" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
