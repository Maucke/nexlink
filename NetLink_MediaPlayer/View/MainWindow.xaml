<mah:MetroWindow x:Class="NetLink_MediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mediaControl="clr-namespace:AxWMPLib;assembly=AxInterop.WMPLib"
        xmlns:local="clr-namespace:NetLink_MediaPlayer"
        xmlns:vm="clr-namespace:NetLink_MediaPlayer.ViewModel"
        xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
        mc:Ignorable="d"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" ResizeMode="CanMinimize"
        Title="NexLink MediaPlayer" Height="525" Width="480" WindowStartupLocation="CenterScreen" Icon="/Resources/mediaplayer.ico">
    <Window.Resources>
        <vm:WidthConverter x:Key="WidthConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadMedia}" CommandParameter="{Binding ElementName=frm_media}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingMedia}" CommandParameter="{Binding ElementName=frm_media}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <TextBlock Text="{Binding USBFPS}" VerticalAlignment="Center" Margin="5" FontFamily="Bauhaus 93" FontSize="14">
            </TextBlock>
            <Button Content="选择媒体" VerticalAlignment="Center" Command="{Binding OpenMedia}"/>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <mah:Flyout x:Name="fly_media" IsOpen="{Binding IsOpenMedia}"
                        Width="300"
                        Header="选择媒体"
                        Position="Right">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="IsOpenChanged">
                        <i:InvokeCommandAction Command="{Binding IsOpenChangedMedia}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Margin="5" Text="当前媒体是：" FontSize="14"/>
                        <TextBlock Margin="5" Text="{Binding CurrentMedia}" TextWrapping ="Wrap"/>
                        <TextBox Name="tbx_url"
                             Margin="5"
                             TextWrapping="Wrap"
                             mah:TextBoxHelper.ButtonCommand="{Binding ChoiceMediaUrl, Mode=OneWay}"
                             mah:TextBoxHelper.ButtonCommandParameter="{Binding ElementName=tbx_url, Path=Text}"
                             mah:TextBoxHelper.ButtonContent="a"
                             mah:TextBoxHelper.Watermark="Enter Url"
                             Style="{DynamicResource MahApps.Styles.TextBox.Button}" />
                        <Button Margin="5" Content="选择文件" Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" Command="{Binding ChoiceMedia}">
                        </Button>
                    </StackPanel>
                    <UniformGrid Grid.Row="2"
                                 Columns="2">
                        <Button Margin="10"
                                Content="确定" Command="{Binding ConfirmMedia}" CommandParameter="{Binding ElementName=fly_media}"
                                Style="{DynamicResource MahApps.Styles.Button.Square}" />
                        <Button Margin="10"
                                Content="取消" Command="{Binding CancelMedia}" CommandParameter="{Binding ElementName=fly_media}"
                                Style="{DynamicResource MahApps.Styles.Button.Square}" />
                    </UniformGrid>

                </Grid>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="45"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <WindowsFormsHost Visibility="{Binding VisibleMedia}">
                <mediaControl:AxWindowsMediaPlayer x:Name="frm_media"/>
            </WindowsFormsHost>
        </Grid>
        <Grid Background="#FF374D51" Grid.Row="1">
            <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                <mah:Badged Panel.ZIndex="1"
                            Margin="4" Height="28"
                            Badge="{Binding DevicesCount}">
                    <Button Content="扫描" Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" Command="{Binding Init}"/>
                </mah:Badged>
                <mah:SplitButton Margin="4" Command="{Binding Connect}" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem}"  SelectedIndex="0" Height="28" BorderThickness="2" Background="#FF2190C5" FontWeight="Bold" BorderBrush="White"
                                DisplayMemberPath="Name" IsEnabled="{Binding USBScaned}" ItemsSource ="{Binding DevicesItems}" SelectedItem ="{Binding DevicesItem}">
                </mah:SplitButton>
                <Button Content="断开连接" Margin="4" Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" Command="{Binding DisConnect}" Visibility="Collapsed">
                </Button>
                <Border BorderThickness="2" BorderBrush="White" Margin="4">
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding USBAlive}">
                        <Label Content="亮度" VerticalAlignment="Center" FontWeight="Bold"></Label>
                        <Slider VerticalAlignment="Center" IsMoveToPointEnabled="True" Margin="4" Width="100" Height="18" Minimum="10"
                         Style="{DynamicResource MahApps.Styles.Slider.Flat}" TickFrequency="5" TickPlacement="TopLeft"
                         Maximum="100" Value="{Binding Brightness}" Cursor="Hand" SmallChange="1">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="ValueChanged">
                                    <i:InvokeCommandAction Command="{Binding BrightnessCommand}" CommandParameter="{Binding Value, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Slider}}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Slider>
                        <TextBlock Text="{Binding Brightness, StringFormat={}{0:0}}" VerticalAlignment="Center" FontFamily="Bauhaus 93" FontSize="18" Margin="2,0"></TextBlock>
                    </StackPanel>
                </Border>
                <Grid>
                    <ScrollViewer Name="scrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <mah:TransitioningContentControl x:Name="textBlock" Content="{Binding NotifyMessage}" FontSize="15" Margin="10,0" FontWeight="Bold" VerticalAlignment="Center"  HorizontalContentAlignment="Right" Transition="Down" >
                            <mah:TransitioningContentControl.RenderTransform>
                                <TranslateTransform x:Name="translateTransform" X="0"/>
                            </mah:TransitioningContentControl.RenderTransform>
                            <mah:TransitioningContentControl.Triggers>
                                <EventTrigger RoutedEvent="SizeChanged">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                    Storyboard.TargetName="translateTransform"
                                    Storyboard.TargetProperty="X"
                                    To="{Binding ElementName=textBlock, Path=ActualWidth, Converter={StaticResource WidthConverter}}"
                                    Duration="0:0:1" AutoReverse="True">
                                                <!--<DoubleAnimation.EasingFunction>
                                                    <BounceEase Bounces="0" EasingMode="EaseInOut" Bounciness="0"/>
                                                </DoubleAnimation.EasingFunction>-->
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </mah:TransitioningContentControl.Triggers>
                        </mah:TransitioningContentControl>
                    </ScrollViewer>
                    <Border Margin="0,0" BorderThickness="0,0,0,0">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                <GradientStop Color="#00374D51" Offset="0.63"/>
                                <GradientStop Color="#90374D51" Offset="0.899"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                    Storyboard.TargetName="translateTransform"
                                    Storyboard.TargetProperty="X"
                                    To="{Binding ElementName=textBlock, Path=ActualWidth, Converter={StaticResource WidthConverter}}"
                                    Duration="0:0:1" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <BounceEase Bounces="0" EasingMode="EaseIn" Bounciness="0" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                    Storyboard.TargetName="translateTransform"
                                    Storyboard.TargetProperty="X"
                                    To="0"
                                    Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <BounceEase Bounces="0" EasingMode="EaseIn" Bounciness="0" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>
