<Window x:Class="NetLink_MediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mediaControl="clr-namespace:AxWMPLib;assembly=AxInterop.WMPLib"
        xmlns:local="clr-namespace:NetLink_MediaPlayer"
        xmlns:vm="clr-namespace:NetLink_MediaPlayer.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="590" Width="480" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid>
            <WindowsFormsHost Name="windowsFormsHost" Margin="0,0,0,30">
                <mediaControl:AxWindowsMediaPlayer x:Name="frm_media"/>
            </WindowsFormsHost>
        </Grid>
        <Button x:Name="btn_init" Content="Init" HorizontalAlignment="Left" Margin="10,0,0,6" Width="44" Height="19" VerticalAlignment="Bottom" Command="{Binding Test}" CommandParameter="{Binding ElementName = frm_media}" />

    </Grid>
</Window>
