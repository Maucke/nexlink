<Page x:Class="NexLink_Tool.Page.Command"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NexLink_Tool"
      mc:Ignorable="d" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DesignHeight="450" d:DesignWidth="1000" FontFamily="Segoe UI">
    <Page.Resources>
        <local:HexConverter x:Key="HexConverter" />
    </Page.Resources>

    <Grid Margin="5">
        <StackPanel>
            <Expander IsExpanded="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Archive24" Filled="True"></ui:SymbolIcon>
                        <TextBlock Grid.Column="1" Text="NexLink Commands" Width="150" HorizontalAlignment="Left" Margin="5" FontWeight="DemiBold"></TextBlock>
                    </Grid>
                </Expander.Header>
                <DockPanel>
                    <ui:Button Margin="5" Width="120" Content="SYNC Time" Command="{Binding SyncTime}" Appearance="Info"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Get Log" Command="{Binding GetLog}" Appearance="Success" Foreground="White"></ui:Button>
                    <ui:Button Margin="5" Width="120" Content="Get Name" Command="{Binding GetName}" Appearance="Light"></ui:Button>
                </DockPanel>
            </Expander>
            <Expander IsExpanded="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArchiveMultiple24" Filled="True"></ui:SymbolIcon>
                        <TextBlock Grid.Column="1" Text="NexLink Advance Commands" HorizontalAlignment="Left" Margin="5" FontWeight="DemiBold"></TextBlock>
                        <ui:Button Grid.Column="2" ToolTip="Add Command" Padding="5,2" Margin="5" Icon="{ui:SymbolIcon Add24}" Command="{Binding Add}" Appearance="Info" Foreground="White"/>
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding NexCommands}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="Delete_Click" CommandParameter="{Binding}">
                                            <MenuItem.Header>
                                                <DockPanel>
                                                    <ui:SymbolIcon Symbol="Delete24" Margin="5"></ui:SymbolIcon>
                                                    <TextBlock Margin="5,0" Grid.Column="1" Text="Delete" VerticalAlignment="Center"></TextBlock>
                                                </DockPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Click="AllRead_Click" CommandParameter="{Binding}">
                                            <MenuItem.Header>
                                                <DockPanel>
                                                    <ui:SymbolIcon Symbol="MailAllRead24" Margin="5"></ui:SymbolIcon>
                                                    <TextBlock Margin="5,0" Grid.Column="1" Text="AutoRead" VerticalAlignment="Center"></TextBlock>
                                                </DockPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <Label Content="ADDR" VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="5,8,5,0"></Label>
                                <TextBox VerticalAlignment="Stretch" Width="50" Text="{Binding Addr,UpdateSourceTrigger=LostFocus,StringFormat={}{0:X2}, Converter={StaticResource HexConverter}}" VerticalContentAlignment="Center" Margin="5"></TextBox>
                                <Label Content="SIZE" VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="5,8,5,0"></Label>
                                <TextBox VerticalAlignment="Stretch" Width="60" Text="{Binding Size}" VerticalContentAlignment="Center" Margin="5"></TextBox>
                                <ui:Button Appearance="Primary" VerticalAlignment="Stretch" Content="Read" HorizontalAlignment="Right" Margin="5" Command="{Binding DataContext.Read, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding}"></ui:Button>
                                <ui:Button Appearance="Transparent" VerticalAlignment="Stretch" Content="Write" HorizontalAlignment="Right" Margin="5" Command="{Binding DataContext.Write, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding}"></ui:Button>
                                <TextBox TextWrapping="Wrap" Text="{Binding Data}" HorizontalAlignment="Stretch" Margin="5" ToolTip="{Binding AsciiData}"></TextBox>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Grid>
</Page>
