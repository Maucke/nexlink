<Page x:Class="NexLink_Tool.Page.Setting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NexLink_Tool.Page"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" FontFamily="Segoe UI"
      Title="Setting">

    <Grid>
        <StackPanel>
            <Expander IsExpanded="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Path HorizontalAlignment="Center" Height="20" Stretch="Uniform" Margin="5" Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M352 448h-256A96 96 0 0 1 0 352v-256A96 96 0 0 1 96 0h256A96 96 0 0 1 448 96v256A96 96 0 0 1 352 448z m-256-384a32 32 0 0 0-32 32v256a32 32 0 0 0 32 32h256a32 32 0 0 0 32-32v-256a32 32 0 0 0-32-32zM800 448A224 224 0 1 1 1024 224 224 224 0 0 1 800 448z m0-384A160 160 0 1 0 960 224 160 160 0 0 0 800 64zM352 1024h-256A96 96 0 0 1 0 928v-256A96 96 0 0 1 96 576h256A96 96 0 0 1 448 672v256A96 96 0 0 1 352 1024z m-256-384a32 32 0 0 0-32 32v256a32 32 0 0 0 32 32h256a32 32 0 0 0 32-32v-256a32 32 0 0 0-32-32zM928 1024h-256A96 96 0 0 1 576 928v-256A96 96 0 0 1 672 576h256a96 96 0 0 1 96 96v256a96 96 0 0 1-96 96z m-256-384a32 32 0 0 0-32 32v256a32 32 0 0 0 32 32h256a32 32 0 0 0 32-32v-256a32 32 0 0 0-32-32z"></Path>
                        <TextBlock Grid.Column="1" Text="NexLink Devices" Width="150" HorizontalAlignment="Left" Margin="5" FontWeight="DemiBold"></TextBlock>
                        <ui:Button Grid.Column="2" ToolTip="Scan devices" Padding="5,2" Margin="5" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding Scan}" Appearance="Success" Foreground="White"/>
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding NexDevices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="5"></TextBlock>
                                <ui:ToggleSwitch IsChecked="{Binding IsConnect}" OnContent="Connect   " OffContent="Disconnect" HorizontalAlignment="Right" Margin="5" Command="{Binding DataContext.Control, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding}"></ui:ToggleSwitch>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Grid>
</Page>
