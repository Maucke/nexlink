# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_1=y
CONFIG_ESP_CONSOLE_UART_NUM=1
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=1
CONFIG_ESP_CONSOLE_UART_TX_GPIO=39
CONFIG_ESP_CONSOLE_UART_RX_GPIO=37
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_DESC_CDC_STRING="NORDIX CDC Bridge"

CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=n
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_VID=0x1337
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x1337
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0210
CONFIG_TINYUSB_DESC_BCD_USB=0x0210
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="NORDIX"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="USB Bridge"
CONFIG_TINYUSB_DESC_SERIAL_STRING="000001"
CONFIG_TINYUSB_DESC_CDC_STRING="NORDIX USB Bridge Module"

CONFIG_TINYUSB_VENDOR_COUNT=1